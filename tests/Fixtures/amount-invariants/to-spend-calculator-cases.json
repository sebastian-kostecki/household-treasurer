        {
            "name": "collected never goes below zero in any month",
            "opening": 0,
            "months": [
                { "rate": 10000, "actual": 30000 },
                { "rate": 10000, "actual": 0 },
                { "rate": 10000, "actual": 5000 }
            ],
            "expected": [
                { "start": 0, "end": 0, "surplus": 20000 },
                { "start": 0, "end": 10000, "surplus": 0 },
                { "start": 10000, "end": 15000, "surplus": 0 }
            ],
            "derivation": "Month 1: end = max(0, 0 + 10000 - 30000) = 0 (floor), surplus = max(0, 30000 - (0 + 10000)) = 20000. Month 2: start 0, end = 0 + 10000 - 0 = 10000, surplus 0. Month 3: start 10000, end = 10000 + 10000 - 5000 = 15000, surplus 0."
        },
