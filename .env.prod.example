APP_NAME="Household Treasurer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://treasurer.kostecki.dev

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=household_treasurer
DB_USERNAME=treasurer
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=treasurer.kostecki.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@kostecki.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_MAIL=admin@kostecki.dev
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_REGION=eu-central
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_USE_PATH_STYLE_ENDPOINT=true
BACKUP_HOST_DIR=/storage/household-treasurer-backups

VITE_APP_NAME="${APP_NAME}"

WWWUSER=1000
WWWGROUP=1000
